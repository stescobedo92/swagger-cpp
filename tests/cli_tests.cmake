cmake_minimum_required(VERSION 3.26)

if(NOT DEFINED CLI OR NOT EXISTS "${CLI}")
    message(FATAL_ERROR "CLI must name the built swaggercpp-cli executable")
endif()
if(NOT DEFINED TEST_DIR OR TEST_DIR STREQUAL "")
    message(FATAL_ERROR "TEST_DIR must name a writable test directory")
endif()

# Each invocation owns its fixtures, including when configurations run concurrently.
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef run_id)
get_filename_component(work "${TEST_DIR}/${run_id}" ABSOLUTE)
file(MAKE_DIRECTORY "${work}")

function(run_cli expected)
    execute_process(
        COMMAND "${CLI}" ${ARGN}
        WORKING_DIRECTORY "${work}"
        RESULT_VARIABLE result
        OUTPUT_VARIABLE output
        ERROR_VARIABLE error
        TIMEOUT 20)
    if(NOT "${result}" STREQUAL "${expected}")
        message(FATAL_ERROR
            "CLI ${ARGN}: expected exit ${expected}, got ${result}\nstdout:\n${output}\nstderr:\n${error}\nFixtures: ${work}")
    endif()
    set(cli_output "${output}" PARENT_SCOPE)
    set(cli_error "${error}" PARENT_SCOPE)
endfunction()

function(expect_equal actual expected description)
    if(NOT "${actual}" STREQUAL "${expected}")
        message(FATAL_ERROR "${description}: expected [${expected}], got [${actual}]")
    endif()
endfunction()

function(expect_json document operation expected)
    string(JSON actual ERROR_VARIABLE error ${operation} "${document}" ${ARGN})
    if(error)
        message(FATAL_ERROR "Cannot inspect JSON ${ARGN}: ${error}\n${document}")
    endif()
    expect_equal("${actual}" "${expected}" "JSON ${operation} ${ARGN}")
endfunction()

function(expect_report ok count)
    expect_json("${cli_output}" GET "${ok}" ok)
    expect_json("${cli_output}" LENGTH "${count}" issues)
    expect_equal("${cli_error}" "" "JSON diagnostics must only use stdout")
endfunction()

function(expect_no_temporary_files)
    file(GLOB_RECURSE temporary_files "${work}/*.tmp")
    if(temporary_files)
        message(FATAL_ERROR "Output staging files were left behind: ${temporary_files}")
    endif()
endfunction()

file(WRITE "${work}/api.json" [=[{
  "openapi": "3.1.0",
  "info": {"title": "CLI contract", "version": "1.0"},
  "paths": {"/items": {"get": {"security": [], "responses": {"200": {"description": "OK"}}}}},
  "components": {"schemas": {
    "Never": false,
    "Value": {"type": ["string", "null"], "enum": ["001", null], "pattern": "^[0-9]+$"}
  }},
  "x-preserved": {"text": "001", "boolean-text": "false", "null-text": "null", "integer": 18446744073709551615},
  "future-field": {"nested": [true, null, "value"]}
}]=])

run_cli(0 --help)
if(NOT cli_output MATCHES "Usage:" OR NOT cli_output MATCHES "bundle")
    message(FATAL_ERROR "Help must describe the available commands")
endif()
run_cli(0 --version)
string(STRIP "${cli_output}" version)
if(NOT version MATCHES "^[0-9]+\\.[0-9]+\\.[0-9]+$")
    message(FATAL_ERROR "Unexpected package version: ${version}")
endif()
run_cli(64)
run_cli(64 unknown api.json)
run_cli(64 convert api.json)
run_cli(64 convert api.json --format xml)
run_cli(64 convert api.json --format)
run_cli(64 validate api.json --format json)
run_cli(64 validate api.json --json --json)
run_cli(64 convert api.json --format json --format yaml)
foreach(port IN ITEMS -1 65536 12junk)
    run_cli(64 serve api.json --no-browser --port "${port}")
endforeach()

# Compare semantic output across both encodings; preserve values YAML might infer.
run_cli(0 convert api.json --format json)
set(canonical "${cli_output}")
expect_json("${canonical}" GET "001" x-preserved text)
expect_json("${canonical}" TYPE STRING x-preserved boolean-text)
expect_json("${canonical}" TYPE STRING x-preserved null-text)
expect_json("${canonical}" GET OFF components schemas Never)
expect_json("${canonical}" LENGTH 2 components schemas Value type)
expect_json("${canonical}" LENGTH 0 paths /items get security)
expect_json("${canonical}" TYPE NULL future-field nested 1)
if(NOT canonical MATCHES "18446744073709551615")
    message(FATAL_ERROR "Conversion lost unsigned 64-bit integer precision")
endif()
run_cli(0 convert api.json --format yaml --output "fresh output.yaml")
expect_equal("${cli_output}" "" "File conversion stdout")
run_cli(0 convert "fresh output.yaml" --format json)
expect_json("${cli_output}" EQUAL ON "${canonical}")
if(NOT cli_output MATCHES "18446744073709551615")
    message(FATAL_ERROR "YAML round trip lost unsigned 64-bit integer precision")
endif()
run_cli(0 convert "fresh output.yaml" --format json --output "fresh output.json")
file(READ "${work}/fresh output.json" fresh_json)
expect_json("${fresh_json}" EQUAL ON "${canonical}")
run_cli(0 convert "fresh output.yaml" --format json --output "fresh output.yaml")
file(READ "${work}/fresh output.yaml" replaced)
expect_json("${replaced}" EQUAL ON "${canonical}")
expect_no_temporary_files()

# Failed input and destination replacement must preserve existing output and
# remove staged files, without relying on platform-specific permission behavior.
file(WRITE "${work}/malformed.json" "{broken")
file(WRITE "${work}/protected.json" "existing output\n")
run_cli(1 convert malformed.json --format json --output protected.json)
file(READ "${work}/protected.json" protected)
expect_equal("${protected}" "existing output\n" "Failed conversion preserves destination")
run_cli(1 convert missing.json --format yaml --output protected.json)
file(READ "${work}/protected.json" protected)
expect_equal("${protected}" "existing output\n" "Missing input preserves destination")
run_cli(1 convert api.json --format json --output absent/created.json)
file(MAKE_DIRECTORY "${work}/destination")
file(WRITE "${work}/destination/keep.txt" "keep")
run_cli(1 convert api.json --format json --output destination)
file(READ "${work}/destination/keep.txt" kept)
expect_equal("${kept}" "keep" "Failed replacement preserves directory contents")
expect_no_temporary_files()

run_cli(0 validate api.json --json)
expect_report(ON 0)
run_cli(0 validate api.json)
if(NOT cli_output MATCHES "Valid:")
    message(FATAL_ERROR "Text validation must report success")
endif()
file(WRITE "${work}/warning-rules.json" "{\"requireOperationId\":true}")
run_cli(0 validate api.json --json --config warning-rules.json)
expect_report(ON 1)
expect_json("${cli_output}" GET warning issues 0 severity)
expect_json("${cli_output}" GET operation.id.required issues 0 ruleId)
expect_json("${cli_output}" GET /paths/~1items/get/operationId issues 0 path)
expect_json("${cli_output}" TYPE STRING issues 0 file)
foreach(position IN ITEMS line column)
    string(JSON value GET "${cli_output}" issues 0 "${position}")
    if(value LESS 1)
        message(FATAL_ERROR "Source ${position} must be one-based")
    endif()
endforeach()
run_cli(2 validate api.json --json --strict --config warning-rules.json)
expect_report(OFF 1)
file(WRITE "${work}/error-rules.json" [=[{"requireOperationId":true,"rules":{"operation.id.required":{"severity":"error"}}}]=])
run_cli(2 validate api.json --json --config error-rules.json)
expect_report(OFF 1)
expect_json("${cli_output}" GET error issues 0 severity)
file(WRITE "${work}/disabled-rules.json" [=[{"requireOperationId":true,"rules":{"operation.id.required":{"enabled":false}}}]=])
run_cli(0 validate api.json --json --strict --config disabled-rules.json)
expect_report(ON 0)
file(WRITE "${work}/invalid-rules.json" [=[{"rules":{"unknown.rule":{"enabled":true}}}]=])
run_cli(64 validate api.json --json --config invalid-rules.json)
expect_report(OFF 1)
expect_json("${cli_output}" GET cli.configuration issues 0 ruleId)
file(WRITE "${work}/malformed-rules.json" "{broken")
run_cli(64 validate api.json --json --config malformed-rules.json)
expect_report(OFF 1)
expect_json("${cli_output}" GET cli.configuration issues 0 ruleId)
run_cli(1 validate api.json --json --config missing-rules.json)
expect_report(OFF 1)
expect_json("${cli_output}" GET cli.io issues 0 ruleId)
run_cli(1 validate malformed.json --json)
expect_json("${cli_output}" GET OFF ok)
run_cli(1 validate missing.json --json)
expect_json("${cli_output}" GET OFF ok)
file(WRITE "${work}/invalid.json" [=[{"openapi":"3.1.0","info":{"title":"","version":"1"},"paths":{}}]=])
run_cli(2 validate invalid.json --json)
expect_report(OFF 1)
expect_json("${cli_output}" GET info.title issues 0 ruleId)

# Resolve a local recursive schema and prove its rewritten pointer still targets
# the bundled schema. No network access is needed by any integration test.
file(MAKE_DIRECTORY "${work}/contract/models")
file(WRITE "${work}/contract/api.json" [=[{"openapi":"3.1.0","info":{"title":"Bundle","version":"1"},"paths":{},"components":{"schemas":{"Node":{"$ref":"models/node.yaml"}}}}]=])
file(WRITE "${work}/contract/models/node.yaml" "type: object\nproperties:\n  next:\n    $ref: node.yaml\n")
run_cli(0 bundle contract/api.json --root contract)
set(bundled "${cli_output}")
string(JSON node_reference GET "${bundled}" components schemas Node $ref)
if(NOT node_reference MATCHES "^#/")
    message(FATAL_ERROR "Bundled reference is not a local JSON pointer: ${node_reference}")
endif()
string(SUBSTRING "${node_reference}" 2 -1 node_pointer)
string(REPLACE "/" ";" node_path "${node_pointer}")
expect_json("${bundled}" GET object ${node_path} type)
expect_json("${bundled}" GET "${node_reference}" ${node_path} properties next $ref)
run_cli(0 bundle contract/api.json --format yaml --output bundle.yaml --root contract)
run_cli(0 convert bundle.yaml --format json)
expect_json("${cli_output}" GET "${node_reference}" components schemas Node $ref)
expect_json("${cli_output}" GET "${node_reference}" ${node_path} properties next $ref)

file(WRITE "${work}/outside.yaml" "type: string\n")
file(WRITE "${work}/contract/escape.json" [=[{"openapi":"3.1.0","info":{"title":"Escape","version":"1"},"paths":{},"components":{"schemas":{"Value":{"$ref":"../outside.yaml"}}}}]=])
run_cli(1 bundle contract/escape.json --root contract --output protected.json)
if(NOT cli_error MATCHES "allowed_root")
    message(FATAL_ERROR "Root restriction must explain the rejected reference: ${cli_error}")
endif()
file(READ "${work}/protected.json" protected)
expect_equal("${protected}" "existing output\n" "Failed bundling preserves destination")
run_cli(0 bundle contract/escape.json --root "${work}")
expect_no_temporary_files()

message(STATUS "CLI integration checks passed (${version}); fixtures: ${work}")
